# Stop searching for .editorconfig files in parent directories
root = true

# Universal rules for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C and C++ source and header files
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 100

# Visual Studio / VS Code C++ specific formatting rules
cpp_indent_braces = false
cpp_indent_namespace_contents = true
cpp_indent_access_specifiers = false
cpp_indent_case_labels = false
cpp_indent_case_contents = true

cpp_new_line_before_open_brace_namespace = same_line
cpp_new_line_before_open_brace_type = same_line
cpp_new_line_before_open_brace_function = new_line
cpp_new_line_before_open_brace_block = same_line
cpp_new_line_before_else = same_line
cpp_new_line_before_catch = same_line

cpp_space_pointer_reference_alignment = left
cpp_space_after_keywords_in_control_flow_statements = true
cpp_space_before_function_open_parenthesis = remove

# Build files (Makefiles require hard tabs)
[Makefile]
indent_style = tab

